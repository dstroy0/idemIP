#
# Without this, clangd has no include path and reports every uint8_t and every src/ header as
# missing. Those are phantom errors: the build is clean. Chasing them into the source is how real
# code gets damaged, so the compilation database is named here.

CompileFlags:
  CompilationDatabase: ../build
